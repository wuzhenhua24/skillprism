# ---- 服务 ----
SKILLPRISM_DATABASE_URL=sqlite:///./var/skillprism.db
SKILLPRISM_REPORT_ROOT=./var/reports
SKILLPRISM_WORK_ROOT=./var/work
SKILLPRISM_LOCAL_SKILLS_ROOT=./var/skills

# ---- 内容来源：管理系统的 zip 下载接口 ----
# 配了 URL 模板就走 zip 下载，留空则用上面的本地目录（仅开发调试）
# 只有 worker 用得到，API 进程不下载内容
# 例：http://<manager>/lingxi-manager/api/resource/{skill_id}/download
SKILLPRISM_CONTENT_URL_TEMPLATE=
SKILLPRISM_CONTENT_TOKEN=
SKILLPRISM_CONTENT_TIMEOUT_SECONDS=60
SKILLPRISM_MAX_DOWNLOAD_BYTES=67108864

# ---- SkillEvaluator CLI（独立安装，不与本服务共用 venv）----
SKILLPRISM_SKILLEVALUATOR_BIN=skillevaluator
SKILLPRISM_POLICY_FILE=./profiles/internal.yaml
SKILLPRISM_EVAL_TIMEOUT_SECONDS=600

# 额外传给评测子进程的环境变量，K=V 逗号分隔。
# 子进程只拿到 PATH/HOME 加一份写死的扫描器环境，本文件里的其他变量都到不了
# 扫描器那一层，所以扫描器的开关只能从这里给。例：
# SKILLPRISM_SCANNER_ENV=SEMGREP_VERSION_CHECK_TIMEOUT=1
# semgrep 的版本检查与 metrics 上报已默认关闭，出网受限的机器无需额外配置。
SKILLPRISM_SCANNER_ENV=

# ---- 失败重试 ----
# 可重试的失败按 BACKOFF * 2^(n-1) 秒退避，封顶 MAX，超过 MAX_ATTEMPTS 次终结。
# 退避不能是 0：没有退避的话几次尝试会在一个轮询周期内烧光，
# 管理系统重启一次就足以把任务打成永久失败。
SKILLPRISM_MAX_ATTEMPTS=3
SKILLPRISM_RETRY_BACKOFF_SECONDS=30
SKILLPRISM_RETRY_BACKOFF_MAX_SECONDS=300

# 启动时自检外部扫描器；缺失即拒绝启动，避免产出 incomplete 却被当成通过
SKILLPRISM_REQUIRE_SCANNERS=true

# ---- Embedding shim（M2）----
# 火山方舟 embeddings 单请求最多 10 条，而 SkillEvaluator 硬编码 64。
# shim 夹在中间做拆分，Tier 1 阶段不使用。
SKILLPRISM_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
SKILLPRISM_ARK_API_KEY=
SKILLPRISM_ARK_BATCH_SIZE=10
SKILLPRISM_SHIM_CONCURRENCY=4
SKILLPRISM_SHIM_RETRIES=3
SKILLPRISM_SHIM_TIMEOUT_SECONDS=120

# ---- Tier 2 worker 传给 skillevaluator 的环境变量（M2）----
# BASE_URL 必须指向 shim，不能直连方舟。
# SKILL_EVAL_EMBEDDING_PROVIDER=openai-compatible
# SKILL_EVAL_EMBEDDING_BASE_URL=http://127.0.0.1:8000/embed/v1
# SKILL_EVAL_EMBEDDING_MODEL=doubao-embedding-vision
# SKILL_EVAL_EMBEDDING_API_KEY=
