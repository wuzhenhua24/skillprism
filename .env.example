# ---- 服务 ----
SES_DATABASE_URL=sqlite:///./var/skill-eval.db
SES_REPORT_ROOT=./var/reports
SES_WORK_ROOT=./var/work
SES_LOCAL_SKILLS_ROOT=./var/skills

# ---- 内容来源：管理系统的 zip 下载接口 ----
# 配了 URL 模板就走 zip 下载，留空则用上面的本地目录（仅开发调试）
SES_CONTENT_URL_TEMPLATE=
SES_CONTENT_TOKEN=
SES_CONTENT_TIMEOUT_SECONDS=60
SES_MAX_DOWNLOAD_BYTES=67108864

# ---- SkillEvaluator CLI（独立安装，不与本服务共用 venv）----
SES_SKILLEVALUATOR_BIN=skillevaluator
SES_POLICY_FILE=./profiles/internal.yaml
SES_EVAL_TIMEOUT_SECONDS=600

# 启动时自检外部扫描器；缺失即拒绝启动，避免产出 incomplete 却被当成通过
SES_REQUIRE_SCANNERS=true

# ---- Embedding shim（M2）----
# 火山方舟 embeddings 单请求最多 10 条，而 SkillEvaluator 硬编码 64。
# shim 夹在中间做拆分，Tier 1 阶段不使用。
SES_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
SES_ARK_API_KEY=
SES_ARK_BATCH_SIZE=10
SES_SHIM_CONCURRENCY=4
SES_SHIM_RETRIES=3
SES_SHIM_TIMEOUT_SECONDS=120

# ---- Tier 2 worker 传给 skillevaluator 的环境变量（M2）----
# BASE_URL 必须指向 shim，不能直连方舟。
# SKILL_EVAL_EMBEDDING_PROVIDER=openai-compatible
# SKILL_EVAL_EMBEDDING_BASE_URL=http://127.0.0.1:8000/embed/v1
# SKILL_EVAL_EMBEDDING_MODEL=doubao-embedding-vision
# SKILL_EVAL_EMBEDDING_API_KEY=
