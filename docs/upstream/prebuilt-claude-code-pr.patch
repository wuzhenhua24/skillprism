 def _agent_import_path(provider: ProviderConfig, agent: str, env_mode: str) -> str | None:
+    """Select the provider wrapper, or the prebuilt-CLI wrapper the operator opted into."""
+    import_path = _provider_agent_import_path(provider, agent, env_mode)
+    if env_mode != "docker" or agent not in _prebuilt_agents():
+        return import_path
+    from skillevaluator.tier3.harbor.local_agents import PREBUILT_AGENT_IMPORT_PATHS, PREBUILT_AGENTS_ENV
+
+    if import_path is not None:
+        raise ValueError(
+            f"{PREBUILT_AGENTS_ENV} includes {agent}, but the {provider.provider} provider routes {agent} "
+            "through a compatibility wrapper that installs the agent itself; unset it for this provider."
+        )
+    return PREBUILT_AGENT_IMPORT_PATHS[agent]
+
+
+def _prebuilt_agents() -> frozenset[str]:
+    """Return the agents whose CLI the operator ships in the Docker evaluation image."""
+    from skillevaluator.tier3.harbor import canonical_agent_name
+    from skillevaluator.tier3.harbor.local_agents import PREBUILT_AGENT_IMPORT_PATHS, PREBUILT_AGENTS_ENV
+
+    raw = os.environ.get(PREBUILT_AGENTS_ENV, "")
+    selected = frozenset(canonical_agent_name(name.strip()) for name in raw.split(",") if name.strip())
+    unsupported = sorted(selected - PREBUILT_AGENT_IMPORT_PATHS.keys())
+    if unsupported:
+        raise ValueError(
+            f"{PREBUILT_AGENTS_ENV} supports only {', '.join(sorted(PREBUILT_AGENT_IMPORT_PATHS))}; "
+            f"unsupported: {', '.join(unsupported)}"
+        )
+    return selected
+
+
+def _provider_agent_import_path(provider: ProviderConfig, agent: str, env_mode: str) -> str | None:
     """Select only the provider-specific wrappers required for this environment."""
     if provider.provider == "openai-compatible" and agent == "codex" and env_mode != ENV_MODE_LOCAL:
         return "skillevaluator.tier3.harbor.local_agents:SkillEvaluatorGatewayCodex"
