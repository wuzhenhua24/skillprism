+#: Operator opt-in naming agents whose CLI already ships in the Docker evaluation image.
+PREBUILT_AGENTS_ENV = "SKILLEVALUATOR_DOCKER_PREBUILT_AGENTS"
+
+
+class SkillEvaluatorPrebuiltClaudeCode(ClaudeCode):
+    """Docker-mode Claude Code for evaluation images that already ship the CLI.
+
+    Harbor's stock install downloads the native binary from downloads.claude.ai
+    in every trial. With the operator opt-in, install only verifies the CLI the
+    image provides; launch, credentials, and permissions stay Harbor's.
+    """
+
+    async def install(self, environment: BaseEnvironment) -> None:
+        missing = shlex.quote(f"{PREBUILT_AGENTS_ENV} includes claude-code, but the image has no claude CLI on PATH")
+        await self.exec_as_agent(
+            environment,
+            command=f"command -v claude >/dev/null 2>&1 || {{ echo {missing} >&2; exit 127; }}; claude --version",
+        )
+
+
 class SkillEvaluatorLocalClaudeCode(ClaudeCode):
     """Claude Code wrapper that skips bootstrap install in local mode."""
 
