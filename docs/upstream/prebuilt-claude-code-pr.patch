index 0000000..5322170
--- /dev/null
+++ b/tests/tier3/test_prebuilt_agents.py
@@ -0,0 +1,126 @@
+# SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+# SPDX-License-Identifier: Apache-2.0
+
+import asyncio
+
+import pytest
+
+pytest.importorskip("harbor")
+
+from harbor.agents.factory import AgentFactory
+from harbor.agents.installed.base import NonZeroAgentExitCodeError
+from harbor.environments.base import ExecResult
+from harbor.models.trial.config import AgentConfig
+
+from skillevaluator.provider_config import ProviderConfig
+from skillevaluator.tier3.harbor import local_agents, runner
+
+PREBUILT_CLAUDE_CODE = "skillevaluator.tier3.harbor.local_agents:SkillEvaluatorPrebuiltClaudeCode"
+
+
+def _provider(name: str) -> ProviderConfig:
+    return ProviderConfig(
+        provider=name,
+        model="vendor/model",
+        api_key="test-key",
+        base_url="https://example.com/v1",
+        litellm_model="openai/vendor/model",
+    )
+
+
+class RecordingEnvironment:
+    def __init__(self, return_code: int = 0):
+        self.commands: list[str] = []
+        self.return_code = return_code
+
+    async def exec(self, command, **_kwargs):
+        self.commands.append(command)
+        return ExecResult(return_code=self.return_code, stdout="2.1.283 (Claude Code)", stderr="")
+
+
+@pytest.mark.parametrize("value", ["claude-code", "claude", " claude-code , "])
+@pytest.mark.parametrize("provider", ["anthropic", "openai", "openai-compatible", "bedrock"])
+def test_docker_opt_in_selects_prebuilt_claude_code(monkeypatch, provider, value):
+    monkeypatch.setenv(local_agents.PREBUILT_AGENTS_ENV, value)
+
+    assert runner._agent_import_path(_provider(provider), "claude-code", "docker") == PREBUILT_CLAUDE_CODE
+
+
+@pytest.mark.parametrize("mode", sorted(runner.HARBOR_ENV_MODES - {"docker"}))
+@pytest.mark.parametrize("provider", ["anthropic", "nv_build", "openai-compatible"])
+@pytest.mark.parametrize("agent", ["claude-code", "codex", "opencode"])
+def test_opt_in_leaves_other_modes_on_their_existing_routes(monkeypatch, mode, provider, agent):
+    config = _provider(provider)
+    monkeypatch.delenv(local_agents.PREBUILT_AGENTS_ENV, raising=False)
+    expected = runner._agent_import_path(config, agent, mode)
+
+    monkeypatch.setenv(local_agents.PREBUILT_AGENTS_ENV, "claude-code")
+
+    assert runner._agent_import_path(config, agent, mode) == expected
+
+
+@pytest.mark.parametrize("value", [None, "", " , "])
+def test_without_opt_in_docker_keeps_stock_claude_code(monkeypatch, value):
+    if value is None:
+        monkeypatch.delenv(local_agents.PREBUILT_AGENTS_ENV, raising=False)
+    else:
+        monkeypatch.setenv(local_agents.PREBUILT_AGENTS_ENV, value)
+
+    assert runner._agent_import_path(_provider("anthropic"), "claude-code", "docker") is None
+
+
+def test_opt_in_rejects_agents_without_a_prebuilt_wrapper(monkeypatch):
+    monkeypatch.setenv(local_agents.PREBUILT_AGENTS_ENV, "claude-code,codex")
+
+    with pytest.raises(ValueError, match="supports only claude-code; unsupported: codex"):
+        runner._agent_import_path(_provider("anthropic"), "claude-code", "docker")
+
+
+def test_opt_in_rejects_a_provider_wrapper_that_installs_the_agent(monkeypatch):
+    monkeypatch.setenv(local_agents.PREBUILT_AGENTS_ENV, "claude-code")
+
+    with pytest.raises(ValueError, match="nv_build provider routes claude-code through a compatibility wrapper"):
+        runner._agent_import_path(_provider("nv_build"), "claude-code", "docker")
+
+
+def test_docker_command_dispatches_prebuilt_claude_code_by_import_path(tmp_path):
+    command = runner.build_harbor_run_command(
+        dataset_path=tmp_path / "tasks",
+        agent="claude-code",
+        job_name="prebuilt",
+        env_mode="docker",
+        model="vendor/model",
+        agent_import_path=PREBUILT_CLAUDE_CODE,
+    )
+
+    assert command[command.index("--agent-import-path") + 1] == PREBUILT_CLAUDE_CODE
+    assert "-a" not in command
+
+
+def _prebuilt_agent(tmp_path):
+    return AgentFactory.create_agent_from_config(
+        AgentConfig(import_path=PREBUILT_CLAUDE_CODE, model_name="vendor/model"),
+        logs_dir=tmp_path / "logs",
+    )
+
+
+def test_prebuilt_install_only_verifies_the_image_cli(tmp_path):
+    agent = _prebuilt_agent(tmp_path)
+    environment = RecordingEnvironment()
+
+    asyncio.run(agent.install(environment))
+
+    assert len(environment.commands) == 1
+    install = environment.commands[0]
+    assert install.endswith("claude --version")
+    for downloader in ("downloads.claude.ai", "bootstrap.sh", "curl", "apt-get", "npm install"):
+        assert downloader not in install
+
+
+def test_prebuilt_install_fails_with_the_opt_in_named_when_the_cli_is_missing(tmp_path):
+    agent = _prebuilt_agent(tmp_path)
+    environment = RecordingEnvironment(return_code=127)
+
+    with pytest.raises(NonZeroAgentExitCodeError, match="exit 127"):
+        asyncio.run(agent.install(environment))
+    assert local_agents.PREBUILT_AGENTS_ENV in environment.commands[0]
